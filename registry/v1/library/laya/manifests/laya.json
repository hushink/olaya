{
  "schema_version": 1,
  "name": "laya",
  "aliases": ["laya:en"],
  "family": "laya",
  "engine": "candle",
  "arch": "modernbert",
  "format": "safetensors",
  "layout": "laya-markers-v1",
  "files": [
    { "path": "model.safetensors", "role": "weights" },
    { "path": "tokenizer/tokenizer.json", "role": "tokenizer" },
    { "path": "rl_agent_config.json", "role": "calibration" },
    { "path": "encoder/config.json", "role": "config" }
  ],
  "calibration_mode": "raw",
  "capabilities": {
    "noul": true,
    "choice": true,
    "score": true,
    "box": false,
    "vision": false
  },
  "license": "Apache-2.0",
  "description": "Laya decision model",
  "release_date": "2026-09-18",
  "source": "hf://convaiinnovations/laya"
}
